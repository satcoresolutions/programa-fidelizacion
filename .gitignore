# ============================================================
# SATCORE SOLUTIONS
# Git Ignore
# ============================================================

# --- Dependencies ---
node_modules/

# --- Next.js ---
.next/
out/
build/

# --- Production ---
dist/

# --- Environment variables and secrets ---
.env
.env.*
!.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Package manager / tooling caches ---
.npm/
.pnpm-store/
.yarn/cache/
.turbo/

# --- Tests and coverage ---
coverage/
.nyc_output/

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Deployment ---
.vercel/
.netlify/

# --- Operating systems ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors and IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- Local certificates and private keys ---
*.pem
*.key
*.p12
*.pfx

# --- Temporary files ---
tmp/
temp/
*.tmp
*.bak